  "typesVersions": {
    "*": {
      "job": ["./dist/types/schema.d.ts"],
      "job-options": ["./dist/types/schema.d.ts"],
      "retry-policy": ["./dist/types/schema.d.ts"],
      "unique-policy": ["./dist/types/schema.d.ts"],
      "error": ["./dist/types/schema.d.ts"],
      "api-error": ["./dist/types/schema.d.ts"],
      "event": ["./dist/types/schema.d.ts"],
      "workflow": ["./dist/types/schema.d.ts"],
      "cron": ["./dist/types/schema.d.ts"],
      "queue-stats": ["./dist/types/schema.d.ts"],
      "worker-info": ["./dist/types/schema.d.ts"],
      "manifest": ["./dist/types/schema.d.ts"],
      "http/enqueue-request": ["./dist/types/schema.d.ts"],
      "http/enqueue-response": ["./dist/types/schema.d.ts"],
      "http/batch-enqueue-request": ["./dist/types/schema.d.ts"],
      "http/batch-enqueue-response": ["./dist/types/schema.d.ts"],
      "http/fetch-request": ["./dist/types/schema.d.ts"],
      "http/fetch-response": ["./dist/types/schema.d.ts"],
      "http/ack-request": ["./dist/types/schema.d.ts"],
      "http/nack-request": ["./dist/types/schema.d.ts"],
      "http/heartbeat-request": ["./dist/types/schema.d.ts"],
      "http/heartbeat-response": ["./dist/types/schema.d.ts"],
      "extensions/ml-resources": ["./dist/types/schema.d.ts"],
      "schemas/*": ["./dist/types/schema.d.ts"]
    }
  },
  "files": [
    "dist/",
    "schemas/",
    "extensions/",
    "tests/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "node --test tests/validate.test.js",
    "validate": "node tests/validate.js",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "attw": "attw --pack",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
